{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/specs/*.md"
  ],
  "permission": {
    "skill": {
      "*": "deny",
      "requirements-spec": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "docker compose down*": "ask",
          "rm -rf *": "ask"
        }
      }
    }
  }
}